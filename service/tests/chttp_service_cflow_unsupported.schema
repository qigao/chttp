schema FlowBad [version(1)];

message OptionalRequest {
  optional uint32 value;
}

message NullableRequest {
  nullable uint32 value;
}

message BaseRequest {
  uint32 value;
}

message Reply {
  uint32 value;
}

message Fault {
  uint32 code;
}

service Calc {
  Optional: OptionalRequest -> Reply;
  Nullable: NullableRequest -> Reply;
  Failing: BaseRequest -> Reply throws Fault;
}
