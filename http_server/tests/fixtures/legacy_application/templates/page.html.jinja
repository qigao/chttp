{% extends "layout.html" %}
{% block content %}
  <h1>{{ title }}</h1>
  <p>Add two whole numbers. For example, 3 + 4 = {{ example_sum }}.</p>
  <form action="/api/add" method="get">
    <p><label for="left">First number (1-4294967295)</label>
      <input id="left" name="left" type="number" min="1" max="4294967295" value="3" required></p>
    <p><label for="right">Second number (0-4294967295)</label>
      <input id="right" name="right" type="number" min="0" max="4294967295" value="4" required></p>
    <button type="submit">Show result as JSON</button>
  </form>
  {% if file_enabled %}<p><a href="/file">View the shared file</a></p>{% endif %}
{% endblock %}
