message AddRequest {
  @Min(1) uint32 left;
  uint32 right;
  optional uint32 scale default 1;
}
message AddResponse {
  @Max(100) uint32 sum;
}
message OwnedRequest {
  uint32 left;
  string note;
  uint32 right;
}
message OwnedResponse {
  uint32 sum;
}
service Calc {
  Add: AddRequest -> AddResponse;
  Note: OwnedRequest -> OwnedResponse;
}
