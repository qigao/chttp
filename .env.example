# Merge these non-secret fields into .env; preserve existing credentials.
# Load .env in the parent process before CMake; values are literal.
VCPKG_CACHE_VERSION=0.1.8
VCPKG_CACHE_REPOSITORY_ROOT=C:/projects/cpp/turbonet/vcpkg-cache
VCPKG_INSTALLED_DIR=C:/sdk/vcpkg-cache-0.1.4-windows-x64/payload/vcpkg_installed
SALTS_BASE_VERSION=0.1.10
SALTS_BASE_ROOT=C:/sdk/salts-base-0.1.10-windows-llvm-mingw-x64
CMETA_VERSION=0.1.10
CMETA_REF=bc67e47d912e8b353a0793fa27a3a4f14504bf69
CMETA_ROOT=C:/sdk/cmeta-0.1.10-windows-llvm-mingw-x64
SALTS_CNET_VERSION=0.1.18
SALTS_CNET_ROOT=C:/sdk/salts-cnet-0.1.18-windows-llvm-mingw-x64
SALTS_UTILS_VERSION=0.1.8
SALTS_UTILS_ROOT=C:/sdk/salts-utils-0.1.8-windows-llvm-mingw-x64
LLVM_MINGW_ROOT=C:/tools/llvm-mingw
VSDEVCMD_BAT=C:/Program Files/Microsoft Visual Studio/2022/BuildTools/Common7/Tools/VsDevCmd.bat
CMAKE_BUILD_PARALLEL_LEVEL=3
# Native formal tests require an independent OpenSSL 3 command-line tool.
CHTTP_TEST_OPENSSL=C:/Program Files/Git/usr/bin/openssl.exe
# If required by that installation, also set OPENSSL_CONF to its openssl.cnf.
# CMeta uses the source SDK flow declared by SaltsUtils 0.1.5.
