VCPKG_CACHE_REPOSITORY_ROOT=C:/projects/cpp/turbonet/vcpkg-cache
VCPKG_INSTALLED_DIR=C:/sdk/vcpkg-cache-0.1.3-windows-x64/payload/vcpkg_installed
