# Merge these non-secret settings into .env; do not overwrite existing credentials.
# Use literal absolute paths with forward slashes; dotenv does not expand variables.
PROJECT_ROOT=C:/projects/cpp
VCPKG_ROOT=C:/tools/vcpkg
VCPKG_CACHE_REPOSITORY_ROOT=C:/Users/your-user/AppData/Local/qigao/vcpkg-cache
VSDEVCMD_BAT=C:/Program Files/Microsoft Visual Studio/2022/Professional/Common7/Tools/VsDevCmd.bat
SALTS_ROOT=C:/projects/cpp/external/pkgs/salts/release
SALTS_UTILS_ROOT=C:/projects/cpp/external/pkgs/salts-utils/release
CMAKE_BUILD_PARALLEL_LEVEL=2
# Shared Qigao.Re2c.Binary host payload; use the resolved package version.
RE2C_ROOT=C:/Users/your-user/.nuget/packages/qigao.re2c.binary/4.6.4/tools/windows-x64

# sdk-build.yml uses the existing CI package preset and its cache environment.
SDK_RESTORE_ROOT=C:/projects/cpp/turbonet/http-services/build/native-sdk
BASH_EXECUTABLE=C:/Program Files/Git/bin/bash.exe
VCPKG_BINARY_SOURCES=clear;default,readwrite;nugettimeout,1800;nugetconfig,C:/projects/cpp/turbonet/http-services/cmake/vcpkg-cache.nuget.config,read

# Supply GITHUB_TOKEN with read:packages in .env or the parent environment.
# Android additionally needs ANDROID_NDK_HOME; iOS needs QIGAO_IOS_SYSROOT.
