{
  "include": [
    "benchmarks/module.json",
    "examples/module.json",
    "tests/module.json"
  ],
  "targets": {
    "chttp_app": {
      "kind": "shared",
      "outputPrefix": "lib",
      "public": {
        "includeDirs": [
          "include"
        ],
        "deps": [
          "chttp_server",
          "cmeta_ace",
          "cmeta_cmeta",
          "salts_databind",
          "cmeta_plugin",
          "cmeta_cflow"
        ]
      },
      "sources": {
        "files": [
          "src/chttp_application.c",
          "src/chttp_application_work.c",
          "src/chttp_invocation.c",
          "src/chttp_method_runtime.c",
          "src/chttp_web.c",
          "src/chttp_web_assets.c",
          "src/chttp_web_auth.c",
          "src/chttp_web_context.c",
          "src/chttp_web_form.c",
          "src/chttp_web_form_plan.c",
          "src/chttp_web_invocation.c",
          "src/chttp_web_multipart.c",
          "src/chttp_web_security.c",
          "src/chttp_web_session.c",
          "src/chttp_web_sse.c",
          "src/chttp_web_upload.c",
          "src/chttp_web_validation.c"
        ]
      },
      "private": {
        "includeDirs": [
          "../http_server/include",
          "../http_common/include",
          "../http_common/http",
          "${envPath:SALTS_UTILS_ROOT}/include/jinja"
        ],
        "deps": [
          "salts_jinja",
          "saltsbase_cserde",
          "chttp_digest",
          "salts_cnet",
          "saltsbase_native_io",
          "saltsbase_coroutine",
          "cmeta_cstl",
          "salts_crypto",
          "saltsbase_asn1",
          "saltsbase_core",
          "saltsbase_simd"
        ],
        "libs": [
          "bcrypt",
          "ws2_32",
          "crypt32"
        ],
        "linkFlags": [
          "-Wl,--export-all-symbols"
        ]
      },
      "install": {
        "headers": [
          {
            "from": "include",
            "to": "include"
          }
        ]
      }
    }
  }
}
