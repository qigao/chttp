schema WebForm [version(1)];

enum Side <uint8> { Buy = 1; Sell = 2; }
message FormValues { uint32 count; Side side; list<uint32> tags; }

message FormRequest {
  @Min(1) uint32 left;
  uint32 right;
  optional uint32 scale default 2;
}
message FormResponse {
  uint32 sum;
}
service Calc {
  Submit: FormRequest -> FormResponse;
  Values: FormValues -> FormResponse;
}
