schema BodyIngress [version(1)];
component BodyPlugin { service Probe; }
message Child { @Min(1) uint32 number; }
message Detail {
  uint64 id;
  Child child;
  string note;
}
message Request { Detail payload; @Min(1) uint32 tenant; }
message Response { Detail payload; }
message Batch { list<Detail> records; list<list<uint64>> rows; list<string> labels; }
message BatchRequest { Batch payload; @Min(1) uint32 tenant; }
message BatchResponse { Batch payload; }
service Probe {
  Echo: Request -> Response;
  Batch: BatchRequest -> BatchResponse;
}
message BinaryBody { bytes data; }
message BinaryRequest { BinaryBody payload; }
message BinarySequence { list<BinaryBody> values; }
message BinarySequenceRequest { BinarySequence payload; }
message Length { uint64 value; }
service RawProbe {
  Size: BinaryRequest -> Length;
  SequenceSize: BinarySequenceRequest -> Length;
}
