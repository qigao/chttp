{
  "version": 6,
  "include": [
    "../BasePresets.json"
  ],
  "configurePresets": [
    {
      "name": "windows-msvc",
      "hidden": true,
      "inherits": [
        "ISWindows",
        "base",
        "toolkit-msvc",
        "flags-msvc"
      ],
      "environment": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-llvm-mingw",
      "hidden": true,
      "inherits": [
        "ISWindows",
        "base",
        "toolkit-llvm-mingw"
      ]
    },
    {
      "name": "target-llvm-mingw-x64",
      "hidden": true,
      "inherits": [
        "toolkit-llvm-mingw-x64",
        "windows-llvm-mingw"
      ],
      "environment": {
        "VCPKG_TARGET_TRIPLET": "qigao-x64-windows-llvm-mingw"
      }
    },
    {
      "name": "target-llvm-mingw-arm64",
      "hidden": true,
      "inherits": [
        "toolkit-llvm-mingw-arm64",
        "windows-llvm-mingw"
      ],
      "environment": {
        "VCPKG_TARGET_TRIPLET": "qigao-arm64-windows-llvm-mingw"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-windows",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "testPresets": [
    {
      "name": "test-windows",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ]
}
