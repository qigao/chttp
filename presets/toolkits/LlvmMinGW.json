{
  "version": 6,
  "configurePresets": [
    {
      "name": "toolkit-llvm-mingw",
      "hidden": true,
      "description": "LLVM-MinGW compiler selection; only the SDK root is machine-specific",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{LLVM_MINGW_ROOT}/bin/$env{LLVM_MINGW_TARGET}-clang.exe",
        "CMAKE_CXX_COMPILER": "$env{LLVM_MINGW_ROOT}/bin/$env{LLVM_MINGW_TARGET}-clang++.exe",
        "CMAKE_AR": "$env{LLVM_MINGW_ROOT}/bin/llvm-ar.exe",
        "CMAKE_RANLIB": "$env{LLVM_MINGW_ROOT}/bin/llvm-ranlib.exe",
        "CMAKE_RC_COMPILER": "$env{LLVM_MINGW_ROOT}/bin/$env{LLVM_MINGW_TARGET}-windres.exe"
      },
      "environment": {
        "LLVM_MINGW_TARGET": "x86_64-w64-mingw32",
        "PATH": "${sourceDir}/build/${presetName}/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{VCPKG_TARGET_TRIPLET}/$env{VCPKG_CONFIGURATION_SUBDIR}bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{VCPKG_TARGET_TRIPLET}/bin${pathListSep}$env{SALTS_CORE_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{CMETA_ROOT}/bin${pathListSep}$env{SALTS_BASE_ROOT}/bin${pathListSep}$env{LLVM_MINGW_ROOT}/$env{LLVM_MINGW_TARGET}/bin${pathListSep}$env{LLVM_MINGW_ROOT}/bin${pathListSep}$penv{PATH}"
      }
    },
    {
      "name": "toolkit-llvm-mingw-x64",
      "hidden": true,
      "inherits": [
        "toolkit-llvm-mingw"
      ],
      "environment": {
        "LLVM_MINGW_TARGET": "x86_64-w64-mingw32"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "x86_64"
      }
    },
    {
      "name": "toolkit-llvm-mingw-arm64",
      "hidden": true,
      "inherits": [
        "toolkit-llvm-mingw"
      ],
      "environment": {
        "LLVM_MINGW_TARGET": "aarch64-w64-mingw32"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_SYSTEM_NAME": "Windows"
      }
    }
  ]
}
