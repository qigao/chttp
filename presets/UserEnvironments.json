{
  "version": 6,
  "include": [
    "../CMakePresets.json"
  ],
  "configurePresets": [
    {
      "name": "vcpkg-cache",
      "hidden": true,
      "environment": {
        "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{VCPKG_CACHE_REPOSITORY_ROOT}",
        "VCPKG_INSTALLED_DIR": "$penv{VCPKG_INSTALLED_DIR}",
        "SALTS_BASE_ROOT": "$penv{SALTS_BASE_ROOT}",
        "CMETA_ROOT": "$penv{CMETA_ROOT}",
        "SALTS_CNET_ROOT": "$penv{SALTS_CNET_ROOT}",
        "SALTS_UTILS_ROOT": "$penv{SALTS_UTILS_ROOT}"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/${presetName}/stage",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "VCPKG_TARGET_TRIPLET": "$env{VCPKG_TARGET_TRIPLET}"
      },
      "description": "Consume preinstalled vcpkg-cache packages without a toolchain or dependency resolver"
    },
    {
      "name": "native-environment",
      "hidden": true,
      "description": "Preinstalled vcpkg packages and runtime paths for native compilers",
      "inherits": [
        "vcpkg-cache",
        "native-runtime"
      ]
    }
  ]
}
