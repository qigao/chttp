@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Salts 1.3.0 EXACT CONFIG REQUIRED PATHS "$ENV{SALTS_ROOT}" NO_DEFAULT_PATH)
find_dependency(SaltsUtils 3.1.0 EXACT CONFIG REQUIRED PATHS "$ENV{SALTS_UTILS_ROOT}" NO_DEFAULT_PATH)
if(NOT TARGET Salts::DataBind)
  set(Chttp_FOUND FALSE)
  set(Chttp_NOT_FOUND_MESSAGE "SaltsUtils must provide the Salts::DataBind component")
  return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ChttpTargets.cmake")
