@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT DEFINED ENV{SALTS_ROOT} OR "$ENV{SALTS_ROOT}" STREQUAL "")
  set(Chttp_FOUND FALSE)
  set(Chttp_NOT_FOUND_MESSAGE "SALTS_ROOT must name the installed Salts 1.8.3 SDK")
  return()
endif()
if(NOT DEFINED ENV{SALTS_UTILS_ROOT} OR "$ENV{SALTS_UTILS_ROOT}" STREQUAL "")
  set(Chttp_FOUND FALSE)
  set(Chttp_NOT_FOUND_MESSAGE "SALTS_UTILS_ROOT must name the installed SaltsUtils 4.1.3 SDK")
  return()
endif()

file(TO_CMAKE_PATH "$ENV{SALTS_ROOT}" _CHTTP_SALTS_ROOT)
file(TO_CMAKE_PATH "$ENV{SALTS_UTILS_ROOT}" _CHTTP_SALTS_UTILS_ROOT)

find_dependency(Salts 1.8.3 EXACT CONFIG REQUIRED
  PATHS "${_CHTTP_SALTS_ROOT}"
  NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
find_dependency(SaltsUtils 4.1.3 EXACT CONFIG REQUIRED
  PATHS "${_CHTTP_SALTS_UTILS_ROOT}"
  NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)

unset(_CHTTP_SALTS_ROOT)
unset(_CHTTP_SALTS_UTILS_ROOT)

if(NOT TARGET Salts::DataBind)
  set(Chttp_FOUND FALSE)
  set(Chttp_NOT_FOUND_MESSAGE "SaltsUtils must provide the Salts::DataBind component")
  return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ChttpTargets.cmake")
