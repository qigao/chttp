@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT DEFINED ENV{SALTS_ROOT} OR NOT IS_DIRECTORY "$ENV{SALTS_ROOT}")
  set(Chttp_FOUND FALSE)
  set(Chttp_NOT_FOUND_MESSAGE "SALTS_ROOT must name the installed Salts SDK")
  return()
endif()
if(NOT DEFINED ENV{SALTS_UTILS_ROOT} OR NOT IS_DIRECTORY "$ENV{SALTS_UTILS_ROOT}")
  set(Chttp_FOUND FALSE)
  set(Chttp_NOT_FOUND_MESSAGE "SALTS_UTILS_ROOT must name the installed SaltsUtils SDK")
  return()
endif()

file(TO_CMAKE_PATH "$ENV{SALTS_ROOT}" _CHTTP_SALTS_ROOT)
file(TO_CMAKE_PATH "$ENV{SALTS_UTILS_ROOT}" _CHTTP_SALTS_UTILS_ROOT)

unset(Salts_DIR CACHE)
unset(Salts_DIR)
unset(SaltsUtils_DIR CACHE)
unset(SaltsUtils_DIR)
find_dependency(Salts CONFIG REQUIRED
  PATHS "${_CHTTP_SALTS_ROOT}"
  NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
find_dependency(SaltsUtils CONFIG REQUIRED
  PATHS "${_CHTTP_SALTS_UTILS_ROOT}"
  NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)

unset(_CHTTP_SALTS_ROOT)
unset(_CHTTP_SALTS_UTILS_ROOT)

if(NOT TARGET Salts::DataBind)
  set(Chttp_FOUND FALSE)
  set(Chttp_NOT_FOUND_MESSAGE "SaltsUtils must provide the Salts::DataBind component")
  return()
endif()
if(NOT TARGET Salts::ComponentPlugin)
  set(Chttp_FOUND FALSE)
  set(Chttp_NOT_FOUND_MESSAGE
    "Salts SDK must provide Salts::ComponentPlugin for CHttp::Service")
  return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ChttpTargets.cmake")
