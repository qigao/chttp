set(PLUGIN_NAME c)
set(PLUGIN_SYMBOL tree_sitter_c)
foreach(query IN ITEMS PLUGIN_QUERY PLUGIN_NAME_QUERY)
        if(query STREQUAL "PLUGIN_QUERY")
                set(query_file "${CMAKE_CURRENT_LIST_DIR}/../queries/extract/c.scm")
        else()
                set(query_file "${CMAKE_CURRENT_LIST_DIR}/../queries/extract/c-name.scm")
        endif()
        file(READ "${query_file}" ${query})
        string(REPLACE "\\" "\\\\" ${query} "${${query}}")
        string(REPLACE "\"" "\\\"" ${query} "${${query}}")
        string(REPLACE "\r" "" ${query} "${${query}}")
        string(REPLACE "\n" "\\n" ${query} "${${query}}")
endforeach()
configure_file("${CMAKE_CURRENT_LIST_DIR}/language.c.in" "${OPENAPI_PLUGIN_OUTPUT}" @ONLY)
