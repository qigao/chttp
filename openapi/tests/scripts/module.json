{
  "targets": {
    "openapi_databind_http_provider": {
      "kind": "header_only",
      "when": {
        "native": true
      },
      "runtimeDeps": [
        "test_databind_http_provider"
      ],
      "test": {
        "program": "${artifact:test_databind_http_provider}"
      }
    },
    "generator": {
      "kind": "header_only",
      "when": {
        "native": true
      },
      "runtimeDeps": [
        "test_generator"
      ],
      "test": {
        "program": "${artifact:test_generator}"
      }
    },
    "openapi_ui_model_case": {
      "kind": "header_only",
      "when": {
        "native": true
      },
      "runtimeDeps": [
        "test_ui_model"
      ],
      "test": {
        "program": "${artifact:test_ui_model}",
        "name": "openapi_ui_model"
      }
    },
    "openapi_ui_renderer": {
      "kind": "header_only",
      "when": {
        "native": true
      },
      "runtimeDeps": [
        "test_ui_renderer"
      ],
      "test": {
        "program": "${artifact:test_ui_renderer}"
      }
    },
    "openapi_ui_fragments": {
      "kind": "header_only",
      "when": {
        "native": true
      },
      "runtimeDeps": [
        "test_ui_fragments"
      ],
      "test": {
        "program": "${artifact:test_ui_fragments}"
      }
    },
    "openapi_ui_htmx": {
      "kind": "header_only",
      "when": {
        "native": true
      },
      "runtimeDeps": [
        "test_ui_htmx"
      ],
      "test": {
        "program": "${artifact:test_ui_htmx}"
      }
    },
    "generator_conformance": {
      "kind": "header_only",
      "when": {
        "native": true
      },
      "runtimeDeps": [
        "openapi-gen",
        "openapi_c"
      ],
      "test": {
        "tool": "python",
        "args": [
          "$root/openapi/tests/conformance.py",
          "--generator",
          "${artifact:openapi-gen}",
          "--plugin",
          "${artifact:openapi_c}",
          "--node",
          "node"
        ]
      }
    },
    "openapi_ui_tryit_logic": {
      "kind": "header_only",
      "when": {
        "native": true
      },
      "test": {
        "tool": "node",
