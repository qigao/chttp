      "kind": "header_only",
      "when": {
        "native": true
      },
      "test": {
        "tool": "python",
        "args": [
          "$root/openapi/tests/ui_final_audit.py"
        ]
      }
    },
    "openapi_ui_security_http": {
      "kind": "header_only",
      "when": {
        "native": true
