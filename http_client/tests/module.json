    "chttp_tls_test": {
      "kind": "executable",
      "sources": {
        "files": [
          "chttp_tls_test.c"
        ]
      },
      "private": {
        "includeDirs": [
          "../../http_common/tests/support",
          "../../http_common/http",
          "../../http_common/rpc",
          "../src",
          "../rpc",
          "../include",
          "../../http_common/include",
          "../../http_server/include"
        ],
        "deps": [
          "chttp_client",
          "chttp_server",
          "saltsbase_tinytest",
          "salts_cnet",
          "salts_crypto",
          "salts_databind",
          "saltsbase_cserde",
          "cmeta_cstl",
          "cmeta_cflow",
          "cmeta_cmeta",
          "saltsbase_native_io",
          "saltsbase_coroutine",
          "saltsbase_core"
        ],
        "defines": {
          "CHTTP_X509_FIXTURE_DIR": "\"$root/http_client/tests/fixtures\"",
          "CHTTP_X509_INVALID_CA_FULLCHAIN": "\"$builddir/http_client/tests/chttp-invalid-ca-fullchain.pem\"",
          "CHTTP_X509_P384_FULLCHAIN": "\"$builddir/http_client/tests/chttp-p384-server-fullchain.pem\""
        },
        "libs": [
          "ws2_32"
        ]
      },
      "test": {},
      "when": {
        "native": true
      },
      "preTasks": [
        {
          "name": "p384_chain",
          "tool": "cmake",
          "inputs": [
            "$root/http_client/tests/fixtures/WriteCertificateChain.cmake",
            "$root/http_client/tests/fixtures/p384-chain-server-cert.pem",
            "$root/http_client/tests/fixtures/p384-chain-intermediate-cert.pem"
          ],
          "outputs": [
            "$builddir/http_client/tests/chttp-p384-server-fullchain.pem"
          ],
          "args": [
            "-DCERTIFICATE=$root/http_client/tests/fixtures/p384-chain-server-cert.pem",
            "-DISSUER_CERTIFICATE=$root/http_client/tests/fixtures/p384-chain-intermediate-cert.pem",
            "-DCERTIFICATE_CHAIN=$builddir/http_client/tests/chttp-p384-server-fullchain.pem",
            "-P",
            "$root/http_client/tests/fixtures/WriteCertificateChain.cmake"
          ]
        },
        {
          "name": "invalid_ca_chain",
          "tool": "cmake",
          "inputs": [
            "$root/http_client/tests/fixtures/WriteCertificateChain.cmake",
            "$root/http_client/tests/fixtures/invalid-ca-server-cert.pem",
            "$root/http_client/tests/fixtures/invalid-ca-issuer-cert.pem"
          ],
          "outputs": [
            "$builddir/http_client/tests/chttp-invalid-ca-fullchain.pem"
          ],
          "args": [
            "-DCERTIFICATE=$root/http_client/tests/fixtures/invalid-ca-server-cert.pem",
            "-DISSUER_CERTIFICATE=$root/http_client/tests/fixtures/invalid-ca-issuer-cert.pem",
            "-DCERTIFICATE_CHAIN=$builddir/http_client/tests/chttp-invalid-ca-fullchain.pem",
            "-P",
            "$root/http_client/tests/fixtures/WriteCertificateChain.cmake"
          ]
        }
      ]
    },
