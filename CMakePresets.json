{
    "version": 6,
    "include": [
        "presets/BuildPresets.json",
        "presets/TestPresets.json"
    ],
    "configurePresets": [
        {
            "name": "base-win-dev-user",
            "hidden": true,
            "displayName": "Developer Build (Windows, Base)",
            "inherits": [
                "dev-win-msvc-ninja",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "base-win-release-user",
            "hidden": true,
            "displayName": "Release Build (Windows, Base)",
            "inherits": [
                "release-win-msvc-ninja",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "base-linux-dev-user",
            "hidden": true,
            "displayName": "Developer Build (Linux, Base)",
            "inherits": [
                "dev-linux-ninja",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "base-win-dev-clang-user",
            "hidden": true,
            "displayName": "Developer Build (Windows, Clang, Base)",
            "inherits": [
                "ISWindows",
                "developer-mode",
                "Clang",
                "flags-clang-windows",
                "pkg-vcpkg"
            ],
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/Clang"
        },
        {
            "name": "base-win-release-clang-user",
            "hidden": true,
            "displayName": "Release Build (Windows, Clang, Base)",
            "inherits": [
                "ISWindows",
                "release-mode",
                "Clang",
                "flags-clang-windows",
                "pkg-vcpkg"
            ],
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/Clang-Release"
        },
        {
            "name": "flags-clang-windows",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-fstack-protector-strong -Wall -Wextra -Wpedantic -Wformat=2 -Wundef -Wshadow -Wcast-align -Wunused -Wnull-dereference",
                "CMAKE_CXX_FLAGS": "-fstack-protector-strong -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wcast-qual -Wformat=2 -Wundef -Werror=float-equal -Wshadow -Wcast-align -Wunused -Wnull-dereference -Wdouble-promotion -Wimplicit-fallthrough -Wextra-semi -Woverloaded-virtual -Wnon-virtual-dtor -Wold-style-cast -fexceptions"
            }
        },
        {
            "name": "base-ci-sdk-release",
            "hidden": true,
            "inherits": [
                "base-ninja",
                "release-mode"
            ],
            "cacheVariables": {
                "VCPKG_INSTALL_OPTIONS": "--only-binarycaching",
                "BUILD_TESTING": false,
                "BUILD_TESTS": false,
                "BUILD_EXAMPLES": false,
                "BUILD_BENCHMARKS": false,
                "ENABLE_SANITIZER_ADDRESS": false
            }
        },
        {
            "name": "base-ci-sdk-release-tests",
            "hidden": true,
            "inherits": "base-ci-sdk-release",
            "cacheVariables": {
                "BUILD_TESTING": true,
                "BUILD_TESTS": true
            }
        },
        {
            "name": "base-ci-android-sdk-release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Android",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-26",
                "ANDROID_STL": "c++_shared"
            }
        },
        {
            "name": "base-ci-ios-sdk-release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "iOS"
            }
        }
    ]
}
