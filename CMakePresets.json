{
    "version": 6,
    "include": [
        "presets/BuildPresets.json",
        "presets/TestPresets.json"
    ],
    "configurePresets": [
        {
            "name": "ci-compiler-cache",
            "hidden": true,
            "description": "Use the CI launcher environment; embed MSVC debug information for sccache",
            "cacheVariables": {
                "CMAKE_C_COMPILER_LAUNCHER": "$penv{CMAKE_C_COMPILER_LAUNCHER}",
                "CMAKE_CXX_COMPILER_LAUNCHER": "$penv{CMAKE_CXX_COMPILER_LAUNCHER}",
                "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "$<$<CONFIG:Debug,RelWithDebInfo>:Embedded>"
            }
        },
        {
            "name": "base-win-dev-user",
            "hidden": true,
            "displayName": "Developer Build (Windows, Base)",
            "inherits": [
                "dev-win-msvc-ninja",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "base-win-release-user",
            "hidden": true,
            "displayName": "Release Build (Windows, Base)",
            "inherits": [
                "release-win-msvc-ninja",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "base-linux-dev-user",
            "hidden": true,
            "displayName": "Developer Build (Linux, Base)",
            "inherits": [
                "dev-linux-ninja",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "base-win-dev-clang-user",
            "hidden": true,
            "displayName": "Developer Build (Windows, Clang, Base)",
            "inherits": [
                "ISWindows",
                "developer-mode",
                "Clang",
                "flags-clang-windows",
                "pkg-vcpkg"
            ],
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/Clang"
        },
        {
            "name": "base-win-release-clang-user",
            "hidden": true,
            "displayName": "Release Build (Windows, Clang, Base)",
            "inherits": [
                "ISWindows",
                "release-mode",
                "Clang",
                "flags-clang-windows",
                "pkg-vcpkg"
            ],
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/Clang-Release"
        },
        {
            "name": "flags-clang-windows",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-fstack-protector-strong -Wall -Wextra -Wpedantic -Wformat=2 -Wundef -Wshadow -Wcast-align -Wunused -Wnull-dereference",
                "CMAKE_CXX_FLAGS": "-fstack-protector-strong -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wcast-qual -Wformat=2 -Wundef -Werror=float-equal -Wshadow -Wcast-align -Wunused -Wnull-dereference -Wdouble-promotion -Wimplicit-fallthrough -Wextra-semi -Woverloaded-virtual -Wnon-virtual-dtor -Wold-style-cast -fexceptions"
            }
        }
    ]
}
